# Exemplo versionado das variaveis exigidas pela aplicacao.
# Copie para .env e preencha com valores reais. O .env nunca e versionado.
# Variavel nova aqui exige atualizar este arquivo na mesma change
# (tech-stack.md, "Configuracao por ambiente").

# Conexao com o PostgreSQL. O nome DATABASE_URL e o que o Prisma le.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=

# Segredo de assinatura da sessao do Auth.js. Gere um valor proprio com:
#   openssl rand -base64 32
AUTH_SECRET=

# Primeiro usuario, criado pelo seed na instalacao. A tela de cadastro de
# usuario exige sessao ativa, entao alguem precisa existir antes dela
# (PRD-00-indice.md, decisao "Primeiro usuario semeado").
USUARIO_INICIAL_NOME=
USUARIO_INICIAL_EMAIL=
USUARIO_INICIAL_SENHA=
